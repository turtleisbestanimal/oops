{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/commerce/**",
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/storefront/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter))/i]",
        "message": "Font not provided by the design system. Available: Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Accordion'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|openIndex|onToggle|style|key|ref|className|style|children)$/]",
        "message": "<Accordion> doesn't accept that prop. Declared props: items, openIndex, onToggle, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BagLineItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|name|category|size|quantity|price|onRemove|iconBase|style|key|ref|className|style|children)$/]",
        "message": "<BagLineItem> doesn't accept that prop. Declared props: image, name, category, size, quantity, price, onRemove, iconBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|fullWidth|as|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, fullWidth, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a|div)$/]",
        "message": "<Button> as must be one of 'button' | 'a' | 'div'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CarouselNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:canPrev|canNext|onPrev|onNext|style|key|ref|className|style|children)$/]",
        "message": "<CarouselNav> doesn't accept that prop. Declared props: canPrev, canNext, onPrev, onNext, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|title|action|ratio|key|ref|className|style|children)$/]",
        "message": "<CategoryTile> doesn't accept that prop. Declared props: image, title, action, ratio."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|label|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, label, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EditorialCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|kicker|title|dark|ratio|key|ref|className|style|children)$/]",
        "message": "<EditorialCard> doesn't accept that prop. Declared props: image, kicker, title, dark, ratio."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|open|onToggle|children|style|key|ref|className|style|children)$/]",
        "message": "<FilterGroup> doesn't accept that prop. Declared props: title, open, onToggle, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|locale|copyright|legal|iconBase|style|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: columns, locale, copyright, legal, iconBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GalleryRail'] > JSXAttribute > JSXIdentifier[name!=/^(?:images|index|onSelect|thumbSize|style|key|ref|className|style|children)$/]",
        "message": "<GalleryRail> doesn't accept that prop. Declared props: images, index, onSelect, thumbSize, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeaderNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|items|active|onSelect|iconBase|style|key|ref|className|style|children)$/]",
        "message": "<HeaderNav> doesn't accept that prop. Declared props: brand, items, active, onSelect, iconBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroBillboard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|eyebrow|title|body|actions|titleSize|style|key|ref|className|style|children)$/]",
        "message": "<HeroBillboard> doesn't accept that prop. Declared props: image, eyebrow, title, body, actions, titleSize, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|base|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, base."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:search|search-alt|bag|heart|pin|phone|chat|plus|minus|star|dash|close|edit|trash|chevron-right|check-circle|truck|caret-down|play|dot)$/]",
        "message": "<Icon> name must be one of 'search' | 'search-alt' | 'bag' | 'heart' | 'pin' | 'phone' | 'chat' | 'plus' | 'minus' | 'star' | 'dash' | 'close' | 'edit' | 'trash' | 'chevron-right' | 'check-circle' | 'truck' | 'caret-down' | 'play' | 'dot'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|variant|label|children|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: size, variant, label, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:plain|muted|filled)$/]",
        "message": "<IconButton> variant must be one of 'plain' | 'muted' | 'filled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LinkColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:heading|links|tone|style|key|ref|className|style|children)$/]",
        "message": "<LinkColumn> doesn't accept that prop. Declared props: heading, links, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LinkColumn'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<LinkColumn> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LocalePopover'] > JSXAttribute > JSXIdentifier[name!=/^(?:message|options|selected|onSelect|onClose|style|key|ref|className|style|children)$/]",
        "message": "<LocalePopover> doesn't accept that prop. Declared props: message, options, selected, onSelect, onClose, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OrderSummary'] > JSXAttribute > JSXIdentifier[name!=/^(?:heading|rows|total|cta|onCheckout|style|key|ref|className|style|children)$/]",
        "message": "<OrderSummary> doesn't accept that prop. Declared props: heading, rows, total, cta, onCheckout, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|children|key|ref|className|style|children)$/]",
        "message": "<Pill> doesn't accept that prop. Declared props: selected, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:price|notes|style|key|ref|className|style|children)$/]",
        "message": "<PriceBlock> doesn't accept that prop. Declared props: price, notes, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|name|category|price|badge|width|key|ref|className|style|children)$/]",
        "message": "<ProductCard> doesn't accept that prop. Declared props: image, name, category, price, badge, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='PromoBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|style|key|ref|className|style|children)$/]",
        "message": "<PromoBanner> doesn't accept that prop. Declared props: title, body, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|action|size|nav|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: title, action, size, nav, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|options|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, options, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SizeChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|disabled|children|key|ref|className|style|children)$/]",
        "message": "<SizeChip> doesn't accept that prop. Declared props: selected, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SizePicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:sizes|value|onChange|unavailable|style|key|ref|className|style|children)$/]",
        "message": "<SizePicker> doesn't accept that prop. Declared props: sizes, value, onChange, unavailable, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SubNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|filtersShown|onToggleFilters|style|key|ref|className|style|children)$/]",
        "message": "<SubNav> doesn't accept that prop. Declared props: title, filtersShown, onToggleFilters, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|trailing|width|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: placeholder, trailing, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='UtilityBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:leading|links|style|key|ref|className|style|children)$/]",
        "message": "<UtilityBar> doesn't accept that prop. Declared props: leading, links, style."
      }
    ]
  },
